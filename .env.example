# Cloud API tokens
# Use different random values for sender and receiver tokens.
SEND_TOKEN=replace-with-random-sender-token
RECEIVER_TOKEN=replace-with-random-receiver-token

# Upstash Redis REST credentials
UPSTASH_REDIS_REST_URL=https://example-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Optional Vercel KV-compatible names are also supported by the API.
# KV_REST_API_URL=https://example-upstash-redis.upstash.io
# KV_REST_API_TOKEN=replace-with-upstash-rest-token

# Cloud API tuning
MAX_MESSAGE_CHARS=32
SENDER_RATE_LIMIT_COUNT=10
SENDER_RATE_LIMIT_WINDOW_SECONDS=60
TRANSIENT_QUEUE_LIMIT=5
DEFAULT_TRANSIENT_TTL_SECONDS=300
DEFAULT_DISPLAY_SECONDS=20
MIN_TTL_SECONDS=1
MAX_TTL_SECONDS=86400
MIN_DISPLAY_SECONDS=1
MAX_DISPLAY_SECONDS=300
REDIS_KEY_PREFIX=k20gt:remote-message

# Local receiver
REMOTE_MESSAGE_API_BASE_URL=https://your-vercel-project.vercel.app
RECEIVER_POLL_INTERVAL_MS=3000
RECEIVER_LOG_LEVEL=info
